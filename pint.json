{
    "preset": "laravel",
    "rules": {
        "concat_space": {"spacing": "one"},
        "new_with_parentheses": true,
        "not_operator_with_successor_space": true,
        "phpdoc_align": {"align": "left"},
        "single_line_empty_body": false,
        "unary_operator_spaces": {"only_dec_inc": true}
    }
}
