{
    "name": "oilstone/system-status",
    "description": "Health checks for system dependencies, exposed to load balancers, uptime monitors and the console",
    "keywords": ["health", "health-check", "monitoring", "status", "laravel"],
    "homepage": "https://github.com/oilstone/system-status",
    "license": "MIT",
    "authors": [
        {
            "name": "Online Solutions",
            "email": "support@onlinesolutionsltd.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^1.1|^2.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Required by the http and oauth_token monitors and any monitor using MakesHttpRequests (^7.0)",
        "ext-pdo": "Required by the pdo monitor",
        "laravel/framework": "Enables the Laravel integration (^10.0|^11.0|^12.0|^13.0)"
    },
    "autoload": {
        "psr-4": {
            "Oilstone\\SystemStatus\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oilstone\\SystemStatus\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "check": ["@lint", "@analyse", "@test"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Oilstone\\SystemStatus\\Integrations\\Laravel\\SystemStatusServiceProvider"
            ],
            "aliases": {
                "SystemStatus": "Oilstone\\SystemStatus\\Integrations\\Laravel\\Facades\\SystemStatus"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
